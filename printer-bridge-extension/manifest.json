{
  "manifest_version": 3,
  "name": "Dom's Café — Pont d'impression",
  "version": "1.0.0",
  "description": "Envoie les tickets (Ticket caisse / Bar / Cuisine) directement à la bonne imprimante Windows, sans boîte de dialogue. Installé une seule fois sur le pc du comptoir.",
  "key": "",
  "permissions": ["printing"],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": ["https://domscafe.pages.dev/*", "http://localhost/*", "http://localhost:*/*"]
  }
}
