  <!-- Mobile-only sticky order bar (see the <script> below for the
       show/hide mechanism) — desktop already has "Commander" in the header,
       but on mobile that's easy to lose track of on a page this long, and
       this page's whole point is to convert pizza browsing into an order. -->
  <div id="pizza-sticky-bar" class="pizza-sticky-bar sm:hidden" aria-hidden="true">
    <a href={orderCtaLabel.href} target="_blank" rel="noreferrer" class="pizza-sticky-bar-link">
      {orderCtaLabel.label}
    </a>
  </div>
