<style>
  .pizza-sticky-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom));
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.35);
    transform: translateY(100%);
    transition: transform 0.3s ease;
  }
  .pizza-sticky-bar.is-visible {
    transform: translateY(0);
  }
  .pizza-sticky-bar-link {
    display: block;
    text-align: center;
    padding: 0.85rem 1rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.95rem;
    background-color: var(--color-accent);
    color: var(--color-background);
  }

  /* ============================================================================
     Oven-door hero reveal — a straight port of HomeContent.astro's own
     #home-hero door mechanism (see the header comment above the markup for
     why it's duplicated rather than shared as a component: it's tightly
     coupled to this hero's own perspective/id, and Astro scopes each
     component's <style> block separately anyway, so copy-and-rescope is
     the honest option here, not a hack). Every rule below is identical to
     Home's except the selector (#home-hero → #pizza-hero) — see that
     file's own much longer comment block for the full design reasoning
     (brushed-steel panel construction, why rotateX not rotateY, the
     client's real-photo-driven feedback that led here, etc). */
  #pizza-hero {
    perspective: 2200px;
  }
  .oven-doors-big {
    position: absolute;
    inset: 0;
    z-index: 50;
    pointer-events: none;
  }
  .oven-glow-big {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, rgba(255, 170, 80, 0.95) 0%, rgba(200, 100, 30, 0.5) 42%, transparent 72%);
    opacity: 0;
    animation: hero-glow-flash 1s ease-out 0.15s both;
  }
  .oven-door-steel {
    position: absolute;
    inset: 0;
    transform-origin: top center;
    background:
      linear-gradient(
        100deg,
        rgba(255, 255, 255, 0.4) 0%,
        transparent 14%,
        transparent 38%,
        rgba(255, 255, 255, 0.3) 47%,
        transparent 56%,
        transparent 80%,
        rgba(255, 255, 255, 0.22) 92%,
        transparent 100%
      ),
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.07) 0px,
        rgba(255, 255, 255, 0.07) 1px,
        transparent 1px,
        transparent 3px
      ),
      linear-gradient(160deg, #e9ebed 0%, #c4c7cc 28%, #f0f1f2 45%, #a7abb1 64%, #d8dadd 100%);
    box-shadow: inset 0 0 70px rgba(0, 0, 0, 0.28);
    backface-visibility: hidden;
    animation: hero-door-open 1.7s cubic-bezier(0.7, 0, 0.3, 1) 0.35s both;
  }
  .oven-door-steel-hinge-shadow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5%;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.35), transparent);
  }
  .oven-door-handle {
    position: absolute;
    left: 50%;
    top: 60%;
    transform: translate(-50%, -50%);
    width: 34%;
    min-width: 160px;
    height: 6%;
    min-height: 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2%;
  }
  .oven-door-handle-bracket {
    width: 8%;
    min-width: 14px;
    height: 150%;
    background: linear-gradient(180deg, #9a9da3, #6c6f74);
    border-radius: 3px;
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.35);
  }
  .oven-door-handle-bar {
    flex: 1;
    height: 100%;
    background: linear-gradient(180deg, #3a3a3c 0%, #1c1c1e 45%, #050505 100%);
    border-radius: 9999px;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.55), inset 0 1px 1px rgba(255, 255, 255, 0.3);
  }

  @keyframes hero-door-open {
    0% { transform: rotateX(0deg); }
    100% { transform: rotateX(-112deg); }
  }
  @keyframes hero-glow-flash {
    0% { opacity: 0; }
    40% { opacity: 1; }
    70% { opacity: 0.35; }
    100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .oven-glow-big {
      display: none;
    }
    .oven-door-steel {
      animation: none;
      transform: rotateX(-112deg);
      opacity: 0;
    }
  }
</style>

<script>
  // Fades the mobile order bar in once the hero (marked by #hero-end-marker
  // just below the hero section) has scrolled out of view, and back out if
  // someone scrolls back up to the top — an IntersectionObserver instead of
  // a scroll listener so this stays cheap on low-end phones. Wrapped in
  // 'astro:page-load' to match this codebase's convention for re-init on
  // View Transitions navigation (see MenuContent.astro's own script).
  document.addEventListener('astro:page-load', () => {
    const bar = document.querySelector<HTMLElement>('#pizza-sticky-bar');
    const marker = document.querySelector<HTMLElement>('#hero-end-marker');
    if (!bar || !marker) return;

    const observer = new IntersectionObserver(
      ([entry]) => {
        const pastHero = !entry.isIntersecting && entry.boundingClientRect.top < 0;
        bar.classList.toggle('is-visible', pastHero);
        bar.setAttribute('aria-hidden', pastHero ? 'false' : 'true');
      },
      { threshold: 0 }
    );
    observer.observe(marker);
  });
</script>
