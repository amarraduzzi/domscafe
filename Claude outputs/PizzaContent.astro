        <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
          <h3 class="font-display text-xl font-semibold" style="color: var(--color-text-primary)">{t(copy.toGoPizzaKicker, lang)}</h3>
          <span class="text-xs italic" style="color: var(--color-text-muted)">{t(copy.toGoPizzaDesc, lang)}</span>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-5">
          {toGoPizzas.map((item, i) => (
            <div
              class="rounded-2xl p-5 flex flex-col items-start"
